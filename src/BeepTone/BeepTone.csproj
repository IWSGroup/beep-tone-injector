<Project Sdk="Microsoft.NET.Sdk">
  <!-- The tray app: mixes the beep into the microphone. Started in each session by the guard service. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>BeepTone</AssemblyName>
    <RootNamespace>BeepTone</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
